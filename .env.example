# ------------------------------------------------------------------
# GameFin Intelligence — environment template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ------------------------------------------------------------------

# REQUIRED by the SEC. EDGAR blocks requests without a descriptive
# User-Agent identifying who is calling. Format: "AppName email".
# See: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="GameFin-Intelligence your.email@example.com"

# --- LLM provider (Phase 2+; not needed for the Phase 1 ingestion run) ---
# The code is provider-agnostic. Set the ONE you use; leave the rest blank.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# For Azure OpenAI, also set the endpoint/deployment when you wire it up.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""

# --- Vector DB (Phase 2+) ---
# Defaults match the docker-compose Qdrant service added in a later step.
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
